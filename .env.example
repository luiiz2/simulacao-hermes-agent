# Copie para `.env` e preencha com seus valores reais. NUNCA commite o .env real.

# ---- Telegram (obrigatório) ----
# Token criado no @BotFather
TELEGRAM_BOT_TOKEN=
# IDs numéricos dos usuários autorizados, separados por vírgula (default-deny)
TELEGRAM_ALLOWED_USER_IDS=

# ---- OpenCode (opcional) ----
DEFAULT_WORKSPACE=C:\caminho\para\seu\projeto
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
# Senha local do `opencode serve` — escolha uma qualquer; fica só na sua máquina
OPENCODE_SERVER_PASSWORD=
# No Windows, o gateway separa automaticamente a config headless da config
# global problemática. Só preencha para escolher outro diretório de runtime.
# GATEWAY_OPENCODE_CONFIG_HOME=C:\caminho\para\config-headless
# GATEWAY_OPENCODE_HEADLESS_CONFIG=false

# ---- Modelos por modo (provider/model do SEU opencode) ----
# Deixe DEFAULT_MODE vazio para o bot aguardar uma escolha explícita no Telegram.
DEFAULT_MODE=
MODEL_AUTO=opencode/x-preview-f-free
MODEL_FAST=opencode/mimo-v2.5-free
MODEL_CODE=opencode/hy3-free
MODEL_DEEP=opencode/nemotron-3-ultra-free
# Fallback opcional separado por vírgula (vazio = não trocar de modelo sozinho)
MODEL_FALLBACKS=
# Timeout máximo em ms por modelo antes de acionar o próximo fallback (default: 25000)
MODEL_TIMEOUT_MS=25000

# IDs dos administradores (com acesso a /sys, /ps, /shot, /open, /shutdown).
# Se vazio, o primeiro ID permitido é mantido como fallback de compatibilidade.
TELEGRAM_ADMIN_USER_IDS=

# Limite para arquivos baixados do Telegram (10 MiB)
MAX_ATTACHMENT_BYTES=10485760

# ---- Debug (opcional) ----
GATEWAY_DEBUG=false

# ---- Instagram Direct (opcional — API oficial Meta) ----
INSTAGRAM_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_PORT=8787
INSTAGRAM_ALLOWED_USER_IDS=
